# Ignore Python virtual environments
venv/
.venv/
.venv310/
*.pyc
__pycache__/

# VS Code workspace
.vscode/

# MacOS
.DS_Store

# Streamlit cache
.streamlit/cache/
.streamlit/machine_id_v4
.pytest_cache/

# Temporary files
*.log
*_new.py
*_temp.py
*_update.py
temp_*.py
verify_*.py

# Local shell/config history (host-specific)
.bash_aliases
.bash_history
.bashrc
.gitconfig
.lesshst
.profile
.wget-hsts
.zshrc

# Local machine caches/config
.cache/
.config/
.copilot/
.dotnet/
.local/
.ssh/
user_preferences.json
outputs/
# Runtime data directory — DB, uploads, generated assets
var/

# Claude Code project settings (machine/user-specific)
.claude/

# Systemd env files
deploy/systemd/*.env
!deploy/systemd/*.env.example
deploy/docker/.env

# Ngrok configuration (keep only example configs tracked)
ngrok.yml
ngrok.yaml
deploy/ngrok/ngrok.yml
deploy/systemd/calb-ngrok@.service.d/override.conf
**/.ngrok2/
.vscode-server/
.git-credentials

# local-only ops records (contain infra details; repo is public)
docs/ops-local/

# Generated proposals. export_docx writes these wherever it is run from, and a
# proposal carries customer figures — this repo is public.
*.docx

# Stray databases. var/ is the runtime home, but a wrong CALB_DATABASE_URL or a
# stray script drops one anywhere; a sizing database is customer data.
*.db
*.sqlite
*.sqlite3
*-wal
*-shm

# Root-level secrets. deploy/{systemd,docker} env files are handled above; this
# closes the top-level ones without disturbing their .example negations.
/.env
/.env.*
/secrets.toml
/.streamlit/secrets.toml
