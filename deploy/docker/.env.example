COMPOSE_PROJECT_NAME=calb-sizingtool
CALB_IMAGE_NAME=calb-sizingtool
CALB_IMAGE_TAG=ubuntu

# Internal access entrypoint. Change this if the server already uses 18511.
CALB_HOST_PORT=18511
STREAMLIT_INTERNAL_PORT=8501

# Keep CALB runtime data outside the repo checkout.
CALB_RUNTIME_ROOT=/opt/calb-sizingtool/runtime
CALB_DATABASE_URL=sqlite:////app/runtime/state/calb_sizing.sqlite
TZ=UTC
CALB_DOCKER_LOG_MAX_SIZE=20m
CALB_DOCKER_LOG_MAX_FILE=5
# Host-side file sweep in calb-maintenance.sh: deletes anything under
# ${CALB_RUNTIME_ROOT}/outputs older than this, by mtime.
CALB_OUTPUT_RETENTION_DAYS=30

# Database-side retention, applied by the same weekly timer but INSIDE the
# container (python -m calb_sizing_tool.services.maintenance_service).
# Rows and their files are always pruned together — never one side alone.
CALB_ARTIFACT_GENERATIONS=1
CALB_ARTIFACT_RETENTION_DAYS=30
CALB_SNAPSHOT_GENERATIONS=3
CALB_AUDIT_RETENTION_DAYS=180
CALB_OPLOG_RETENTION_DAYS=30

# Files under outputs/artifacts that NO registry row points at. Left blank the
# sweep only COUNTS them and prints the number to the journal; set to 1 to
# delete. Read the counted number first — if it is close to your whole outputs
# tree, the sweep is looking at the wrong database, not at garbage.
CALB_UNREFERENCED_GRACE_DAYS=7
CALB_PRUNE_UNREFERENCED_FILES=

# First-admin bootstrap guard for empty deployed databases.
# Keep this true on shared servers. Set CALB_BOOTSTRAP_ADMIN_TOKEN
# before first login, then store the real admin credentials safely.
CALB_REQUIRE_BOOTSTRAP_TOKEN=true
CALB_BOOTSTRAP_ADMIN_TOKEN=

# Alembic should fail fast in deployments. Local one-off experiments may set
# this true, but normal startup should not silently fall back to create_all().
CALB_ALLOW_CREATE_ALL_FALLBACK=false

# Leave this disabled on shared servers unless you explicitly want global journal cleanup.
CALB_ENABLE_GLOBAL_JOURNAL_VACUUM=false
CALB_GLOBAL_JOURNAL_RETENTION=14d

# Optional ngrok tunnel for external access. Leave blank if not used.
NGROK_AUTHTOKEN=

# Optional fixed ngrok URL, for example: https://example.ngrok.app
NGROK_URL=
